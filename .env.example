# ============================================================================
# Configuración de conexión a SQL Server
#
# Copia este archivo como ".env" y ajusta los valores a tu equipo:
#     copy .env.example .env
#
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ============================================================================

# Servidor o instancia de SQL Server. Ejemplos:
#   localhost\SQLEXPRESS      -> instancia Express local (lo más común)
#   localhost                 -> instancia predeterminada
#   localhost,1433            -> servidor + puerto TCP
#   DESKTOP-ABC\SQLEXPRESS    -> otra computadora de la red
DB_SERVER=localhost\SQLEXPRESS

# Puerto TCP. Déjalo vacío cuando uses una instancia con nombre
# (por ejemplo localhost\SQLEXPRESS). Si usas "localhost", pon 1433.
DB_PORT=

# Nombre de la base de datos. Si la cambias, scripts/init_db.py la crea
# con ese nombre.
DB_NAME=PruebaDB

# Autenticación:
#   yes -> autenticación de Windows (usuario de Windows, sin contraseña)
#   no  -> usuario y contraseña de SQL Server
DB_TRUSTED_CONNECTION=yes

# Solo se usan cuando DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=

# Driver ODBC. Déjalo vacío para detectarlo automáticamente.
# Recomendado: ODBC Driver 18 for SQL Server
# También funciona: ODBC Driver 17 for SQL Server
DB_DRIVER=

# Cifrado (solo ODBC Driver 17/18). Con un SQL Server local que usa un
# certificado autofirmado hay que dejar TrustServerCertificate=yes.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
